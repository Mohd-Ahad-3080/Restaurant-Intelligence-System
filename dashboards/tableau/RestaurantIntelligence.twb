            <column-instance column='[aggregate_rating]' derivation='Avg' name='[avg:aggregate_rating:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.dd492d8ce8c2e53c87289f9c2c24].[none:cuisine:nk]'>
            <groupfilter count='15' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='COUNTD([restaurant_id])' function='order' user:ui-marker='order'>
