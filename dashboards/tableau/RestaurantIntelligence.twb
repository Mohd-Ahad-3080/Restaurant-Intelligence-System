          <datasource-dependencies datasource='federated.dd492d8ce8c2e53c87289f9c2c24'>
            <column caption='Aggregate Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[aggregate_rating]' role='measure' type='quantitative' />
            <column caption='Cuisine' datatype='string' name='[cuisine]' role='dimension' type='nominal' />
            <column caption='Restaurant Id' datatype='integer' name='[restaurant_id]' role='dimension' type='ordinal' />
