      <aliases enabled='yes' />
      <column caption='restaurant_cuisines_city.csv' datatype='table' name='[__tableau_internal_object_id__].[restaurant_cuisines_city.csv_AC39A667E4AB124CFE0CDE96710BF4BC]' role='measure' type='quantitative' />
      <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
      <column caption='Cuisine' datatype='string' name='[cuisine]' role='dimension' type='nominal' />
      <column caption='Restaurant Id' datatype='integer' name='[restaurant_id]' role='dimension' type='ordinal' />
      <column caption='Price Range' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[price_range]' role='measure' type='quantitative' />
      <column caption='Aggregate Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[aggregate_rating]' role='measure' type='quantitative' />
      <column caption='City group' datatype='string' name='[Calculation_city_group]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [city] : COUNTD([restaurant_id]) } &gt;= 50 THEN [city] ELSE &quot;Other cities&quot; END' />
            </column>
      <column caption='Cuisine group' datatype='string' name='[Calculation_cuisine_group]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [cuisine] IN (&quot;North Indian&quot;, &quot;Chinese&quot;, &quot;Fast Food&quot;, &quot;Mughlai&quot;, &quot;Bakery&quot;) THEN [cuisine] ELSE &quot;Other&quot; END' />
            </column>
      <column caption='City has 50+ restaurants' datatype='boolean' name='[Calculation_big_city]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [city] : COUNTD([restaurant_id]) } &gt;= 50' />
            </column>
      <column caption='Share of cuisine listings' datatype='real' default-format='p0%' name='[Calculation_listing_share]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([restaurant_id]) / MIN({ FIXED [city] : COUNT([restaurant_id]) })' />
            </column>
      <column caption='Label (dark bars)' datatype='real' default-format='p0%' name='[Calculation_label_dark]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([Calculation_cuisine_group]) IN (&quot;North Indian&quot;, &quot;Chinese&quot;, &quot;Fast Food&quot;) THEN [Calculation_listing_share] END' />
