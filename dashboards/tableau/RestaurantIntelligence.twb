    <worksheet name='India - Top 10 localities (rating and High popularity)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#18181b' fontsize='11'>Top 10 localities: restaurants, average rating, High popularity</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_india' name='federated.5b969f7427f76a5a334119c247fc' />
            <datasource caption='Parameters' name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.5b969f7427f76a5a334119c247fc'>
            <column caption='Average rating (rated)' datatype='real' default-format='n#,##0.00' name='[Calculation_avg_rating]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_primary_row] = 1 THEN [aggregate_rating] END)' />
            </column>
            <column caption='High popularity (rated)' datatype='real' default-format='p0.0%' name='[Calculation_high_pct]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_primary_row] = 1 AND [is_rated] = 1 THEN [is_high] END)' />
            </column>
            <column caption='In selection' datatype='boolean' name='[Calculation_in_selection]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([Parameters].[Parameter 1] = &quot;All cities&quot; OR [city] = [Parameters].[Parameter 1]) AND ([Parameters].[Parameter 2] = &quot;All localities&quot; OR [locality_city] = [Parameters].[Parameter 2])' />
            </column>
            <column caption='Restaurants' datatype='integer' default-format='n#,##0' name='[Calculation_restaurants]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_primary_row])' />
            </column>
            <column caption='Aggregate rating' datatype='real' name='[aggregate_rating]' role='measure' type='quantitative' />
            <column caption='City' datatype='string' name='[city]' role='dimension' type='nominal' />
            <column caption='Is high' datatype='integer' name='[is_high]' role='measure' type='quantitative' />
            <column caption='Primary row' datatype='integer' name='[is_primary_row]' role='measure' type='quantitative' />
            <column caption='Is rated' datatype='integer' name='[is_rated]' role='measure' type='quantitative' />
            <column caption='Locality (city)' datatype='string' name='[locality_city]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_in_selection]' derivation='None' name='[none:Calculation_in_selection:nk]' pivot='key' type='nominal' />
            <column-instance column='[locality_city]' derivation='None' name='[none:locality_city:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_restaurants]' derivation='User' name='[usr:Calculation_restaurants:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_avg_rating]' derivation='User' name='[usr:Calculation_avg_rating:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_high_pct]' derivation='User' name='[usr:Calculation_high_pct:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='Parameters'>
