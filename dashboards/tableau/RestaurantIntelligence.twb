        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='restaurant_cuisines_city' name='federated.dd492d8ce8c2e53c87289f9c2c24' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.dd492d8ce8c2e53c87289f9c2c24'>
            <column caption='City has 50+ restaurants' datatype='boolean' name='[Calculation_big_city]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [city] : COUNTD([restaurant_id]) } &gt;= 50' />
            </column>
            <column caption='Cuisine group' datatype='string' name='[Calculation_cuisine_group]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [cuisine] IN (&quot;North Indian&quot;, &quot;Chinese&quot;, &quot;Fast Food&quot;, &quot;Mughlai&quot;, &quot;Bakery&quot;) THEN [cuisine] ELSE &quot;Other&quot; END' />
            </column>
            <column caption='Label (dark bars)' datatype='real' default-format='p0%' name='[Calculation_label_dark]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([Calculation_cuisine_group]) IN (&quot;North Indian&quot;, &quot;Chinese&quot;, &quot;Fast Food&quot;) THEN [Calculation_listing_share] END' />
            </column>
            <column caption='Label (light bars)' datatype='real' default-format='p0%' name='[Calculation_label_light]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([Calculation_cuisine_group]) IN (&quot;North Indian&quot;, &quot;Chinese&quot;, &quot;Fast Food&quot;) THEN NULL ELSE [Calculation_listing_share] END' />
            </column>
            <column caption='Share of cuisine listings' datatype='real' default-format='p0%' name='[Calculation_listing_share]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([restaurant_id]) / MIN({ FIXED [city] : COUNT([restaurant_id]) })' />
            </column>
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Restaurant Id' datatype='integer' name='[restaurant_id]' role='dimension' type='ordinal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_cuisine_group]' derivation='None' name='[none:Calculation_cuisine_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_big_city]' derivation='None' name='[none:Calculation_big_city:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_listing_share]' derivation='User' name='[usr:Calculation_listing_share:qk]' pivot='key' type='quantitative' />
            <column-instance column='[restaurant_id]' derivation='CountD' name='[ctd:restaurant_id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_label_dark]' derivation='User' name='[usr:Calculation_label_dark:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_label_light]' derivation='User' name='[usr:Calculation_label_light:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.dd492d8ce8c2e53c87289f9c2c24].[none:Calculation_big_city:nk]'>
            <groupfilter function='member' level='[none:Calculation_big_city:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <sort class='computed' column='[federated.dd492d8ce8c2e53c87289f9c2c24].[none:city:nk]' direction='DESC' using='[federated.dd492d8ce8c2e53c87289f9c2c24].[ctd:restaurant_id:qk]' />
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' field='[federated.dd492d8ce8c2e53c87289f9c2c24].[usr:Calculation_listing_share:qk]' scope='rows' value='Share of cuisine listings' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='rows' value='false' />
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.dd492d8ce8c2e53c87289f9c2c24].[none:Calculation_cuisine_group:nk]' />
              <text column='[federated.dd492d8ce8c2e53c87289f9c2c24].[usr:Calculation_label_dark:qk]' />
              <text column='[federated.dd492d8ce8c2e53c87289f9c2c24].[usr:Calculation_label_light:qk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#ffffff' fontsize='9'>&lt;[federated.dd492d8ce8c2e53c87289f9c2c24].[usr:Calculation_label_dark:qk]&gt;</run>
                <run fontcolor='#18181b' fontsize='9'>&lt;[federated.dd492d8ce8c2e53c87289f9c2c24].[usr:Calculation_label_light:qk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.dd492d8ce8c2e53c87289f9c2c24].[usr:Calculation_listing_share:qk]</rows>
        <cols>[federated.dd492d8ce8c2e53c87289f9c2c24].[none:city:nk]</cols>
      </table>
