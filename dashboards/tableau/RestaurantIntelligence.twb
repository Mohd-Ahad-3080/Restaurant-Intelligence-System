      <aliases enabled='yes' />
      <column caption='tableau_india.csv' datatype='table' name='[__tableau_internal_object_id__].[tableau_india.csv_DC914AFA22AAC02CF66DE2D35572CC3D]' role='measure' type='quantitative' />
      <column caption='Restaurant Id' datatype='integer' name='[restaurant_id]' role='dimension' type='ordinal' />
      <column caption='Primary row' datatype='integer' name='[is_primary_row]' role='measure' type='quantitative' />
      <column caption='City' datatype='string' name='[city]' role='dimension' type='nominal' />
      <column caption='Locality (city)' datatype='string' name='[locality_city]' role='dimension' type='nominal' />
      <column caption='Cuisine' datatype='string' name='[cuisine]' role='dimension' type='nominal' />
      <column caption='Price range' datatype='string' name='[price_label]' role='dimension' type='nominal' />
      <column caption='In selection' datatype='boolean' name='[Calculation_in_selection]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([Parameters].[Parameter 1] = &quot;All cities&quot; OR [city] = [Parameters].[Parameter 1]) AND ([Parameters].[Parameter 2] = &quot;All localities&quot; OR [locality_city] = [Parameters].[Parameter 2])' />
            </column>
      <column caption='Restaurants' datatype='integer' default-format='n#,##0' name='[Calculation_restaurants]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_primary_row])' />
            </column>
      <column caption='Average rating (rated)' datatype='real' default-format='n#,##0.00' name='[Calculation_avg_rating]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_primary_row] = 1 THEN [aggregate_rating] END)' />
            </column>
      <column caption='High popularity (rated)' datatype='real' default-format='p0.0%' name='[Calculation_high_pct]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_primary_row] = 1 AND [is_rated] = 1 THEN [is_high] END)' />
            </column>
      <column caption='Online delivery' datatype='real' default-format='p0.0%' name='[Calculation_delivery_pct]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_primary_row] = 1 THEN [has_online_delivery] END)' />
            </column>
      <column caption='Table booking' datatype='real' default-format='p0.0%' name='[Calculation_booking_pct]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_primary_row] = 1 THEN [has_table_booking] END)' />
            </column>
      <column caption='Average cost for two (INR)' datatype='real' default-format='n#,##0' name='[Calculation_cost_inr]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_primary_row] = 1 THEN [avg_cost_for_two] END)' />
            </column>
      <column caption='Average cost for two (US$, approx.)' datatype='real' default-format='n#,##0.00' name='[Calculation_cost_usd]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_primary_row] = 1 THEN [avg_cost_for_two_usd] END)' />
            </column>
      <column caption='Share of city&apos;s restaurants' datatype='real' default-format='p0%' name='[Calculation_price_share]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_primary_row]) / MIN({ FIXED [city] : SUM([is_primary_row]) })' />
            </column>
      <column caption='Message' datatype='string' name='[Calculation_msg_any]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ZN(SUM(IF [Calculation_in_selection] THEN [is_primary_row] END)) = 0 THEN &quot;No data for this selection&quot; ELSE &quot;&quot; END' />
            </column>
      <column caption='Message (rated)' datatype='string' name='[Calculation_msg_rated]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ZN(SUM(IF [Calculation_in_selection] AND [is_rated] = 1 THEN [is_primary_row] END)) = 0 THEN &quot;No data for this selection&quot; ELSE &quot;&quot; END' />
            </column>
      <column caption='Locality' datatype='string' name='[locality]' role='dimension' type='nominal' />
      <column caption='Price range' datatype='integer' name='[price_range]' role='measure' type='quantitative' />
      <column caption='Has online delivery' datatype='integer' name='[has_online_delivery]' role='measure' type='quantitative' />
      <column caption='Has table booking' datatype='integer' name='[has_table_booking]' role='measure' type='quantitative' />
      <column caption='Aggregate rating' datatype='real' name='[aggregate_rating]' role='measure' type='quantitative' />
      <column caption='Votes' datatype='integer' name='[votes]' role='measure' type='quantitative' />
      <column caption='Is rated' datatype='integer' name='[is_rated]' role='measure' type='quantitative' />
      <column caption='Is high' datatype='integer' name='[is_high]' role='measure' type='quantitative' />
      <column caption='Avg cost for two' datatype='real' name='[avg_cost_for_two]' role='measure' type='quantitative' />
      <column caption='Avg cost for two usd' datatype='real' name='[avg_cost_for_two_usd]' role='measure' type='quantitative' />
