    <worksheet name='Average rating by city (top 15)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#18181b' fontsize='11'>Average rating: top 15 cities (cities with 20+ rated restaurants)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='zomato_clean' name='federated.13mbsw307bkwkh10ytzzu1rg2fdp' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.13mbsw307bkwkh10ytzzu1rg2fdp'>
            <column caption='City has 20+ rated restaurants' datatype='boolean' name='[Calculation_city_rated20]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [city] : SUM([is_rated]) } &gt;= 20' />
            </column>
            <column caption='Aggregate Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[aggregate_rating]' role='measure' type='quantitative' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column-instance column='[aggregate_rating]' derivation='Avg' name='[avg:aggregate_rating:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_city_rated20]' derivation='None' name='[none:Calculation_city_rated20:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.13mbsw307bkwkh10ytzzu1rg2fdp].[none:Calculation_city_rated20:nk]' context='true'>
            <groupfilter function='member' level='[none:Calculation_city_rated20:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.13mbsw307bkwkh10ytzzu1rg2fdp].[none:city:nk]'>
            <groupfilter count='15' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='AVG([aggregate_rating])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:city:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <sort class='computed' column='[federated.13mbsw307bkwkh10ytzzu1rg2fdp].[none:city:nk]' direction='DESC' using='[federated.13mbsw307bkwkh10ytzzu1rg2fdp].[avg:aggregate_rating:qk]' />
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' field='[federated.13mbsw307bkwkh10ytzzu1rg2fdp].[avg:aggregate_rating:qk]' scope='cols' value='Average rating' />
