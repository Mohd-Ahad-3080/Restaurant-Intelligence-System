table restaurants
	lineageTag: c46063e0-b43e-4d23-8093-ad69fbd9e800

	measure Restaurants = COUNTROWS ( restaurants )
		formatString: #,0
		lineageTag: f1fc01a3-1d65-5523-809a-414d2f292279

	measure Cities = DISTINCTCOUNT ( restaurants[city] )
		formatString: #,0
		lineageTag: 5e778567-6e28-5e8f-9721-77da5c693c28

	measure 'Avg Rating' = AVERAGE ( restaurants[aggregate_rating] )
		formatString: 0.00
		lineageTag: 3d3ae679-e62c-516e-b1b8-fd983e94158a

	measure 'Total Votes' = SUM ( restaurants[votes] )
		formatString: #,0
		lineageTag: 21945a0d-7b76-5d7e-a134-dd17c6704609

	measure 'Online Delivery %' = DIVIDE ( CALCULATE ( [Restaurants], restaurants[has_online_delivery] = 1 ), [Restaurants] )
		formatString: 0.0%
		lineageTag: 7a52ee10-92bb-5f8a-aba8-9190345e0c54

	measure 'Table Booking %' = DIVIDE ( CALCULATE ( [Restaurants], restaurants[has_table_booking] = 1 ), [Restaurants] )
		formatString: 0.0%
		lineageTag: 867f8ab4-ed1b-57af-b988-f4fabdb2a913

	measure 'Rated Restaurants' = CALCULATE ( [Restaurants], restaurants[is_rated] = 1 )
		formatString: #,0
		lineageTag: 8c5a6eeb-425e-5c5a-9057-cc4fe28d82e5

	measure 'Unrated %' = DIVIDE ( [Restaurants] - [Rated Restaurants], [Restaurants] )
		formatString: 0.0%
		lineageTag: 7bd63013-860e-5e9d-90ca-e3835a4afb68

	measure 'Avg Votes' = AVERAGE ( restaurants[votes] )
		formatString: #,0.0
		lineageTag: 66d16a27-1241-5256-99ec-51de598cb752

	measure 'Avg Cost for Two (local)' = AVERAGE ( restaurants[avg_cost_for_two] )
		formatString: #,0
		lineageTag: 9adc357c-aab2-5a74-9ea6-2a81b9c9ca20

	measure 'Avg Cost for Two (US$ approx)' = AVERAGE ( restaurants[avg_cost_for_two_usd] )
		formatString: #,0.00
		lineageTag: 765649f8-fd58-5fa2-8d11-2d024b9e9746

	measure 'High Popularity %' = DIVIDE ( CALCULATE ( [Rated Restaurants], restaurants[popularity_class] = "High" ), [Rated Restaurants] )
		formatString: 0.0%
		lineageTag: 18ac8c37-f5d9-5025-82db-98118220f722

	measure 'Top 10 City Restaurants' = IF ( RANKX ( ALLSELECTED ( restaurants[city] ), [Restaurants], , DESC, Skip ) <= 10, [Restaurants] )
		formatString: #,0
		lineageTag: c46ae0c7-730f-55ec-a8c9-0ec85379afb9

	measure 'Top 10 City Restaurants by Price' = IF ( RANKX ( ALLSELECTED ( restaurants[city] ), CALCULATE ( [Restaurants], ALLSELECTED ( restaurants[price_label] ) ), , DESC, Skip ) <= 10, [Restaurants] )
		formatString: #,0
		lineageTag: e17fa71a-4573-54ae-a440-dd78a2087158

	measure 'T10 Locality High Popularity %' = IF ( NOT ISBLANK ( [Top 10 Locality Restaurants] ), [High Popularity %] )
		formatString: 0.0%
		lineageTag: 035a5865-2804-5252-96a2-2f46b0572fa2

	measure 'T10 Locality Avg Cost (local)' = IF ( NOT ISBLANK ( [Top 10 Locality Restaurants] ), [Avg Cost for Two (local)] )
		formatString: #,0
		lineageTag: e96c5671-e8a5-549c-89e0-5b4cf4bf4a0a

	measure 'Cuisine Restaurants' = DISTINCTCOUNT ( restaurant_cuisines[restaurant_id] )
		formatString: #,0
		lineageTag: 97115953-95a5-519c-8408-6765958e407b

	measure 'Avg Price Range' = AVERAGE ( restaurants[price_range] )
		formatString: 0.00
		lineageTag: e296ef84-5abc-5879-9477-2279a3a5ec41

	measure 'Top 10 Cuisine Restaurants' = IF ( RANKX ( ALLSELECTED ( restaurant_cuisines[cuisine] ), [Cuisine Restaurants], , DESC, Skip ) <= 10, [Cuisine Restaurants] )
		formatString: #,0
		lineageTag: 7a35bfdb-3b97-5684-9d85-e07c2f8bcbab

	measure 'Top 10 Country Restaurants' = IF ( RANKX ( ALLSELECTED ( restaurants[country] ), [Restaurants], , DESC, Skip ) <= 10, [Restaurants] )
		formatString: #,0
		lineageTag: 489bd658-779c-5d76-87b4-e16d8c53e16d

	measure 'Service %' = SWITCH ( SELECTEDVALUE ( services[service_order] ), 1, [Table Booking %], 2, [Online Delivery %] )
		formatString: 0.0%
		lineageTag: a2cf512e-2b90-546d-ac1f-5ac33a0c104e

	measure 'Price Bar Color' = SELECTEDVALUE ( restaurants[price_color], "#5C5C66" )
		lineageTag: 2c5fc8f9-6c1f-58c3-8dfe-90d4a17da462

	measure 'Rating Bar Color' = SELECTEDVALUE ( restaurants[rating_bar_color], "#5C5C66" )
		lineageTag: e910541f-8989-545b-b55b-cd0a4e1c1112

	measure 'Rated Avg Votes' = CALCULATE ( AVERAGE ( restaurants[votes] ), restaurants[is_rated] = 1 )
		formatString: #,0
		lineageTag: c9d0db9f-0319-5fbd-837e-8a790d2808b2

	measure Localities = COUNTROWS ( SUMMARIZE ( restaurants, restaurants[city], restaurants[locality] ) )
		formatString: #,0
		lineageTag: 06cf50d3-884f-5ddd-a8f0-06235ad80bb8

	measure 'Top 10 Locality Restaurants' = IF ( RANKX ( ALLSELECTED ( restaurants[locality_city] ), [Restaurants], , DESC, Skip ) <= 10, [Restaurants] )
		formatString: #,0
		lineageTag: ebb406db-ef13-5165-8623-fe3180af33f7

	measure 'Avg Rating (India)' = CALCULATE ( [Avg Rating], KEEPFILTERS ( restaurants[country] = "India" ) )
