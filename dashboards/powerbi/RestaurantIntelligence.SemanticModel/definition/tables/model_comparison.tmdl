table model_comparison
	lineageTag: 526a3985-9c7c-4997-a98f-225b3188c45c

	measure 'Best Model' = CALCULATE ( SELECTEDVALUE ( model_comparison[model] ), model_comparison[is_best] = 1 )
		lineageTag: 877ee4f6-009e-5853-8494-f5dc38e25026

	measure 'Best Accuracy' = CALCULATE ( MAX ( model_comparison[test_accuracy] ), model_comparison[is_best] = 1 )
		formatString: 0.0%
		lineageTag: 942edb59-018c-54c2-8a97-447089e24ee2

	measure 'Best Macro F1' = CALCULATE ( MAX ( model_comparison[test_f1_macro] ), model_comparison[is_best] = 1 )
		formatString: 0.000
		lineageTag: ed33207b-ffa1-5f5a-a1ed-f14585aabdcf

	measure 'Best ROC AUC' = CALCULATE ( MAX ( model_comparison[test_roc_auc_ovr_macro] ), model_comparison[is_best] = 1 )
		formatString: 0.000
		lineageTag: de53e3d8-6516-538c-84d9-7719c961df80

	measure 'Baseline Accuracy' = CALCULATE ( MAX ( model_comparison[test_accuracy] ), model_comparison[model] = "Baseline (majority class)" )
		formatString: 0.0%
		lineageTag: 2712df9d-3d66-5223-b4c2-24648484b3bd

	measure 'Title p4_kpi1' = IF ( ISBLANK ( [Best Model] ), "No data for this selection", "Best model" )
		lineageTag: 8f346b4c-19d0-57e1-9924-6444474c1731

	measure 'Title p4_kpi2' = IF ( ISBLANK ( [Best Accuracy] ), "No data for this selection", "Test accuracy" )
		lineageTag: c6835989-7c4e-539b-bb14-a12ee98156ec

	measure 'Title p4_kpi3' = IF ( ISBLANK ( [Best Macro F1] ), "No data for this selection", "Macro F1" )
		lineageTag: b543529d-4a11-54e5-b487-982d4091686a

	measure 'Title p4_kpi4' = IF ( ISBLANK ( [Best ROC AUC] ), "No data for this selection", "ROC-AUC (one-vs-rest)" )
		lineageTag: 42af6398-3dd6-54d2-8b38-5dc05697bb22

	measure 'Title p4_kpi5' = IF ( ISBLANK ( [Baseline Accuracy] ), "No data for this selection", "Baseline accuracy (majority class)" )
		lineageTag: 6e46dc48-0e7b-510f-887d-2270e81c8665

	measure 'Title p4_metrics' = IF ( ISBLANK ( COUNTROWS ( 'model_comparison' ) ), "No data for this selection", "Model comparison (test set; macro averages)" )
		lineageTag: 9ebd8ee2-bfac-5e78-b730-7bf62b69f2a6

