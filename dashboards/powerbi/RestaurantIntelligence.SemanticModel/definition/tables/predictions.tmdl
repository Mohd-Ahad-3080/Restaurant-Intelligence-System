table predictions
	lineageTag: b4928596-e85f-4371-87dd-079b929792bb

	measure 'Predicted Class Color' = SELECTEDVALUE ( predictions[predicted_color], "#5C5C66" )
		lineageTag: 7e8b39a1-9f98-5659-a4ed-9258c6b9992d

	measure 'Predicted Restaurants' = COUNTROWS ( predictions )
		formatString: #,0
		lineageTag: ecf62cc4-3b83-5aac-b7f6-b7fc94ef5609

	measure 'Prediction Agreement %' = AVERAGE ( predictions[correct] )
		formatString: 0.0%
		lineageTag: 216b7ee1-925d-50e9-a469-8c1726c85030

	measure 'Title p4_predicted_split' = IF ( ISBLANK ( [Predicted Restaurants] ), "No data for this selection", "Predicted popularity class (rated restaurants)" )
