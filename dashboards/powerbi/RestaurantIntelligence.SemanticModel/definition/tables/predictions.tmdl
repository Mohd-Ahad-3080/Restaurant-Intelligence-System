	partition predictions = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("D:\restaurant-intelligence\dashboards\powerbi\powerbi_data.xlsx"), null, true),
				    predictions_Sheet = Source{[Item="predictions",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(predictions_Sheet, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"restaurant_id", Int64.Type}, {"actual_class", type text}, {"predicted_class", type text}, {"prob_low", type number}, {"prob_medium", type number}, {"prob_high", type number}, {"split", type text}, {"correct", Int64.Type}, {"model", type text}, {"actual_order", Int64.Type}, {"predicted_order", Int64.Type}, {"predicted_color", type text}, {"result", type text}})
				in
				    #"Changed Type"

